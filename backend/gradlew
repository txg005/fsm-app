#!/bin/sh
# Text-only bootstrap for the genuine, SHA-pinned Gradle wrapper.
# Materialize the JAR beside its properties so Android Studio can use it too.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER="$APP_HOME/gradle/wrapper"
JAR="$WRAPPER/gradle-wrapper.jar"
EXPECTED=$(tr -d '\r\n' < "$WRAPPER/gradle-wrapper.jar.sha256")
verify() {
  ACTUAL=$(sha256sum < "$1")
  ACTUAL=${ACTUAL%% *}
  if [ "$ACTUAL" != "$EXPECTED" ]; then
    echo "Gradle wrapper SHA-256 mismatch: $1. Refusing to run Java." >&2
    exit 1
  fi
}
if [ ! -f "$JAR" ]; then
  TMP=$(mktemp "$WRAPPER/.wrapper-XXXXXX.tmp")
  trap 'rm -f "$TMP"' 0
  trap 'exit 1' HUP INT TERM
  URL=$(tr -d '\r\n' < "$WRAPPER/gradle-wrapper.jar.url")
  curl --fail --location --retry 2 --proto '=https' --proto-redir '=https' "$URL" -o "$TMP"
  verify "$TMP"
  mv -f "$TMP" "$JAR"
fi
verify "$JAR"
if [ -n "${JAVA_HOME:-}" ]; then JAVA="$JAVA_HOME/bin/java"; else JAVA=java; fi
exec "$JAVA" -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain -p "$APP_HOME" "$@"
